// Copy this file to Secrets.xcconfig and replace the values.
// Never commit Secrets.xcconfig. Client publishable keys are not server secrets,
// but use your own development projects and apply the documented RLS policies.
SUPABASE_URL = https:/$()/YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY = YOUR_SUPABASE_PUBLISHABLE_KEY
REVENUECAT_IOS_KEY = YOUR_REVENUECAT_PUBLIC_IOS_KEY
